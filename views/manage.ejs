<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ניהול</title>
    <link rel="stylesheet" href="css/manage.css">
    <link rel="icon" type="image/x-icon" href="img/favicon.ico">
</head>

<body class="fade-in">

    <%- include('./partials/headerStatic'); %>

        <nav class="manageNav" id="navbar">
            <div class="manageNavInner">
                <button class="manageNavBtn is-active" data-target="products"
                    onclick="navtab('products', this)">מוצרים</button>
                <button class="manageNavBtn" data-target="clients" onclick="navtab('clients', this)">משתמשים</button>
                <button class="manageNavBtn" data-target="data" onclick="navtab('data', this)">נתונים</button>
                <button class="manageNavBtn" data-target="manage" onclick="navtab('manage', this)">ניהול</button>
                <button class="manageNavBtn" data-target="messages" onclick="navtab('messages', this)">הודעות</button>
                <button class="manageNavBtn" data-target="shopTheme" onclick="navtab('shopTheme', this)">עיצוב
                    חנות</button>
                <button class="manageNavBtn" data-target="chatbot" onclick="navtab('chatbot', this)">אוטומטים</button>
                <a class="manageNavBtn manageNavLink" href="./accountant" target="_blank">דף הנהלת חשבונות</a>
                <a class="manageNavBtn manageNavLink" href="./app">מסך משתמש</a>
            </div>
        </nav>

        <!-- products -->

        <div class="content column products page" id="products">

            <p2>מוצרים</p2>

            <div class="row linebreak"></div>

            <div class="productManager">
                <div class="productToolbar">
                    <p class="sectionTitle">רשימת מוצרים</p>
                    <div class="toolbarActions">
                        <button class="green" onclick="getProducts()">רענן רשימה</button>
                        <button class="outline jumpAddBtn" onclick="scrollToAddProduct()">הוסף מוצר</button>
                        <label class="toggleGroup">
                            <input type="checkbox" id="hideOutOfStock" onchange="toggleHideOutOfStock(this)">
                            <span>הסתר פריטים שלא בתפריט</span>
                        </label>
                        <span class="hintText">גרור שורות כדי לשנות סדר</span>
                    </div>
                </div>

                <div class="productsTable" id="productsTable">
                    <div class="productsRow productsHeader">
                        <div class="cell dragCell">גרור</div>
                        <div class="cell orderCell">סדר</div>
                        <div class="cell nameCell">שם</div>
                        <div class="cell priceCell">מחיר</div>
                        <div class="cell stockCell">בתפריט</div>
                        <div class="cell imageCell">תמונה</div>
                        <div class="cell actionsCell">פעולות</div>
                    </div>
                    <div id="productsTableBody"></div>
                </div>

                <div class="row">
                    <div class="logText" id="productsEditLog">-</div>
                </div>
            </div>

            <div class="undoToast" id="productUndoToast">
                <span id="undoMessage"></span>
                <button class="undoBtn" onclick="undoLastProductChange()">בטל</button>
            </div>

            <div class="row linebreak"></div>

            <div class="addProduct">
                <div class="function column">
                    <p>הכנסת מוצר</p>
                    <p>שם מוצר : </p>
                    <input type="search" class="textbox" id="insertProduct" spellcheck="false" placeholder=" הכנס מוצר">
                    <p> מחיר : </p>
                    <input type="text" class="textboxNumber" id="insertPrice" min="0" maxlength="4" id="pin"
                        pattern="\d{4}" required spellcheck="false" placeholder=" הכנס מחיר  ">
                    <p> תמונה : </p>
                    <div class="imgDiv row" id="imgDiv"></div>
                    <div class="selectedImageLabel" id="selectedImageLabel">תמונה נבחרת: -</div>
                    <button class="green" onclick="insertProduct()">הכנס מוצר</button>
                    </p>
                </div>

                <div class="row">
                    <div class="logText" id="productsLog">-</div>
                </div>

            </div>

            <div class="row linebreak"></div>

            <div class="uploadImg">
                <p>הוספת תמונה</p>
                <input id="imageSelector" type="file" name="imgUpload" text="" style="display: none;">
                <input type="button" class="mboardButton" value="בחר תמונה"
                    onclick="document.getElementById('imageSelector').click();" id="imageAddButton"
                    style="display: block;" />
                <input type="button" class="mboardButton" value="הסר תמונה" onclick="imageCancel()"
                    id="imageRemoveButton" style="display: none;" />
                <img class="productImgUploadPreview" id="productImgUploadPreview" src="#">
                <input type="button" id="productImageSendButton" class="mboardButton" value="שלח תמונה"
                    onclick="productImageUploadSend()" style="display: none;">
                <div id="progBarDiv" class="progBarDiv">
                    <div id="progBar" class="progBar"></div>
                </div>
            </div>

            <div class="row linebreak"></div>

        </div>

        <!-- messages -->

        <div class="content column manage page" id="messages">

            <p2>הודעות רצות</p2>

            <div class="row linebreak"></div>

            <div class="messageControlBar">
                <button class="green" onclick="loadDisplayMessages()">רענון הודעות</button>
                <span class="hintText">סמן הודעה לתצוגה, קבע זמני והזן סדר ידני.</span>
            </div>

            <div class="messageControlBar">
                <label class="rangeGroup">
                    <span>מהירות גלילה</span>
                    <input type="range" id="scrollDelayMs" min="5" max="50" step="1">
                    <span class="rangeValue" id="scrollDelayValue">10</span>
                </label>
                <select class="select" id="scrollTextColor">
                    <option value="default">צבע רגיל</option>
                    <option value="mint">מנטה</option>
                    <option value="amber">ענבר</option>
                    <option value="rose">ורוד</option>
                </select>
                <input type="color" id="scrollTextColorCustom" value="#f09e06" title="צבע מותאם">
                <select class="select" id="scrollOrderMode">
                    <option value="random">סדר אקראי</option>
                    <option value="order">סדר ידני</option>
                </select>
                <button class="outline" onclick="saveThemeSelection()">שמירת הגדרות תצוגה</button>
                <span class="hintText">5 = מהיר, 50 = איטי</span>
            </div>

            <div class="messageControlBar">
                <label class="rangeGroup">
                    <span>גודל טקסט</span>
                    <input type="range" id="scrollTextSize" min="12" max="32" step="1">
                    <span class="rangeValue" id="scrollTextSizeValue">18</span>
                </label>
                <label class="rangeGroup">
                    <span>ריווח אותיות</span>
                    <input type="range" id="scrollTextSpacing" min="0" max="4" step="0.5">
                    <span class="rangeValue" id="scrollTextSpacingValue">0</span>
                </label>
                <select class="select" id="scrollTextWeight">
                    <option value="400">רגיל</option>
                    <option value="600">חצי מודגש</option>
                    <option value="700">מודגש</option>
                </select>
            </div>

            <div class="messageControlBar messageAddBar">
                <textarea class="messageInput" id="customMessageText" rows="2" placeholder="הוסף הודעה חדשה"></textarea>
                <label class="toggleGroup">
                    <input type="checkbox" id="customMessageTemporary">
                    <span>זמני</span>
                </label>
                <select class="select messagePriority" id="customMessagePriority">
                    <option value="2">עדיפות גבוהה</option>
                    <option value="1" selected>עדיפות רגילה</option>
                    <option value="0">עדיפות נמוכה</option>
                </select>
                <input type="number" class="textboxNumber" id="customMessageDuration" min="1" max="180" value="5">
                <input type="number" class="textboxNumber" id="customMessageOrder" min="0" max="999" value="0">
                <button class="green" onclick="addCustomDisplayMessage()">הוספה</button>
            </div>

            <div class="messageTable" id="displayMessagesTable"></div>

            <div class="row">
                <div class="logText" id="displayMessagesLog">-</div>
            </div>

            <div class="row linebreak"></div>

        </div>

        <!-- clients -->

        <div class="content column clients page" id="clients">

            <p2>משתמשים</p2>

            <div class="row linebreak"></div>

            <div class="editUser">
                <div class="function">
                    <p>עריכת משתמש קיים</p>
                    <input type="search" class="searchBoxNoLogged" id="getUserByName" spellcheck="false"
                        placeholder=" הכנס שם">
                    <div class="autoCompleteNone" id="autoComplete"></div>
                </div>
                <div class="row">
                    <input type="search" class="textboxShort" id="editName" spellcheck="false" placeholder="ערוך שם">
                    <button onclick="editClient(1,'editName')">עריכת שם</button>
                    <div class="row"></div>
                    <input type="search" class="textboxShort" id="editNick" spellcheck="false" placeholder="ערוך כינוי">
                    <button onclick="editClient(2,'editNick')">עריכת כינוי</button>
                </div>
                <div class="row">
                    <input type="number" class="textboxNumber" id="editNumber" spellcheck="false"
                        placeholder="ערוך מספר חשבון">
                    <button onclick="editClient(3,'editNumber')">עריכת מספר</button>
                    <button class="center orange" onclick="clientGetOrderHistory()">צפייה בהסטוריית הזמנות</button>
                    <button class="center orange" onclick="clientDeleteLastOrder()">מחיקת הזמנה אחרונה</button>
                    <button class="red" onclick="deleteClient()">מחיקת משתמש</button>
                </div>
                <br>
                <div class="row">
                    <div class="logText" id="editLog">-</div>
                </div>
            </div>

            <div class="row linebreak"></div>

            <div class="addUser">
                <div class="function column">
                    <p>הכנסת משתמש חדש</p>
                    <p>שם משתמש : </p>
                    <input type="search" class="textbox" id="insertName" spellcheck="false" placeholder=" הכנס שם"
                        onchange="copyNameToNick()">
                    <p>כינוי : </p>
                    <input type="search" class="textbox" id="insertNick" spellcheck="false" placeholder=" הכנס כינוי ">
                    <p>מספר חשבון : </p>
                    <input type="text" class="textboxNumber" id="insertNumber" min="0" maxlength="4" id="pin"
                        pattern="\d{4}" required spellcheck="false" placeholder=" הכנס מספר חשבון ">
                    <button class="green" onclick="insertName()">הכנס משתמש</button>
                    </p>
                </div>

                <div class="row">
                    <div class="logText" id="addLog">-</div>
                </div>

            </div>

            <div class="row linebreak"></div>

            <div class="addUser">
                <div class="function column">
                    <p>טעינת קובץ משתמשים</p>
                    <button class="green" onclick="importNameListFile()">טעינת קובץ משתמשים</button>
                </div>

            </div>

        </div>

        <!-- data -->

        <div class="content column data page" id="data">

            <p2>נתונים</p2>

            <div class="row linebreak"></div>

            <button onClick="openInfotables()">הצגת </button>

            <div class="content row">

                <div class="function" id="getAccounData">
                    <button onclick="getAllData(4)">נתונים לדו"ח</button>
                </div>

                <div class="function" id="getOrdersData">
                    <button onclick="getAllData(1)">נתוני עסקאות</button>
                </div>

                <div class="function" id="getCLientData">
                    <button onclick="getAllData(2)">נתוני משתמשים</button>
                </div>

                <div class="function" id="getCLientData">
                    <button onclick="getAllData(3)">נתוני משתמשים כולל כלבים</button>
                </div>

            </div>

            <div class="row"></div>

            <div class="row linebreak"></div>

            <div class="archive">
                <p>ארכיון</p>
                <select class="select" name="reportArchive" id="reportArchive">
                </select>
                <button class="green" onclick="requestReportArchive()">הצג נתוני ארכיון</button>
            </div>

            <div class="function" id="backupTable">
                <button class="orange" onclick="backupTable()">יצירת גיבוי חדש</button>
            </div>

            <div class="row"></div>

            <div class="function" id="resetDbData">
                <button class="red" onclick="resetAfterReport()">איפוס נתונים לאחר קריאה</button>
            </div>

            <div class="row linebreak"></div>

        </div>

        <!-- manage -->

        <div class="content column manage page" id="manage">

            <p2>ניהול</p2>

            <div class="row linebreak"></div>

            <div class="row">
                <p>מסופים מחוברים :</p>
                <p id="connectedTerminals"></p>
                <button onclick="connectedTerminalsStatus()">לחץ לרענון</button>
            </div>

            <div class="row">
                <button onclick="refreshAllClients()">טען מחדש את כל המסופים</button>
            </div>

            <div class="row linebreak"></div>

            <br>
            <div class="clear">
                <button onclick="clearConsole()">clear console</button>
            </div>
            <div class="console" id="console">
            </div>

            <div class="row linebreak"></div>

        </div>

        <!-- shop theme editor -->

        <div class="content column manage page" id="shopTheme">

            <p2>עיצוב חנות</p2>

            <div class="row linebreak"></div>

            <div class="themeEditor">
                <div class="editorSection">
                    <p>ערכת תצוגה</p>
                    <div class="row">
                        <select class="select" id="themeSelect">
                            <option value="default">ברירת מחדל</option>
                            <option value="aurora">Aurora</option>
                            <option value="dark-night">Dark Night Disco</option>
                            <option value="earth-bound">Earth Bound</option>
                            <option value="forest-mist">Forest Mist</option>
                        </select>
                    </div>
                </div>

                <div class="editorSection">
                    <p>רקע עדין</p>
                    <div class="row">
                        <select class="select" id="backgroundSelect">
                            <option value="none">ללא</option>
                            <option value="static">סטטי</option>
                            <option value="animated">תנועה עדינה</option>
                        </select>
                    </div>
                </div>

                <div class="editorSection">
                    <p>רקע תמונה</p>
                    <div class="row">
                        <label class="toggleGroup">
                            <input type="checkbox" id="backgroundRandomEnabled">
                            <span>החלפה אוטומטית</span>
                        </label>
                        <label class="toggleGroup">
                            <input type="checkbox" id="backgroundRandomAll" onchange="toggleBackgroundRandomAll()">
                            <span>רנדום מכל התמונות</span>
                        </label>
                        <input type="number" class="textboxNumber" id="backgroundRandomIntervalMin" min="1" max="180"
                            step="1" placeholder="10">
                        <span class="hintText">דקות להחלפה</span>
                    </div>
                    <div class="row">
                        <label class="toggleGroup">
                            <input type="checkbox" id="backgroundFoldersAll" onchange="toggleBackgroundFoldersAll()">
                            <span>כל התיקיות</span>
                        </label>
                    </div>
                    <div class="backgroundFolderList" id="backgroundFolderList"></div>
                    <div class="hintText">בחר תמונה ראשית ולסמן מאגר לרנדום.</div>
                    <div class="backgroundGallery" id="backgroundGallery"></div>
                </div>

                <div class="editorSection">
                    <p>שכבות רקע</p>
                    <div class="row backgroundControlRow">
                        <label class="rangeGroup">
                            <span>עוצמת תמונה</span>
                            <input type="range" id="backgroundImageOpacity" min="0" max="100" step="1">
                            <span class="rangeValue" id="backgroundImageOpacityValue">8%</span>
                        </label>
                    </div>
                    <div class="row backgroundControlRow">
                        <select class="select" id="backgroundOverlayColor">
                            <option value="">ללא צבע</option>
                            <option value="#f1f5f9">אפור בהיר</option>
                            <option value="#0f172a">כחול לילה</option>
                            <option value="#1f2937">גרפיט</option>
                            <option value="#1f4d2b">יער</option>
                            <option value="#7a2e1d">נחושת</option>
                            <option value="#5b3b8a">סגול עמוק</option>
                            <option value="#0b3f4b">טורקיז כהה</option>
                        </select>
                        <select class="select" id="backgroundPattern">
                            <option value="none">ללא דוגמה</option>
                            <option value="dots">נקודות</option>
                            <option value="grid">רשת</option>
                            <option value="diagonal">אלכסונים</option>
                            <option value="waves">גלים</option>
                        </select>
                    </div>
                    <div class="hintText">צבע ודוגמה נשארים גם כשאין תמונה.</div>
                </div>

                <div class="editorSection">
                    <p>תצוגת הודעות רצות</p>
                    <div class="row">
                        <label class="toggleGroup">
                            <input type="checkbox" id="scrollEnabled" onchange="saveThemeSelection()">
                            <span>הפעל</span>
                        </label>
                    </div>
                    <div class="row">
                        <select class="select" id="scrollLocation">
                            <option value="top">מיקום: למעלה</option>
                            <option value="bottom">מיקום: למטה</option>
                        </select>
                        <select class="select" id="scrollTextColor">
                            <option value="default">צבע רגיל</option>
                            <option value="mint">מנטה</option>
                            <option value="amber">ענבר</option>
                            <option value="rose">ורוד</option>
                        </select>
                    </div>
                </div>

                <div class="editorSection">
                    <button class="green" onclick="saveThemeSelection()">שמירה והחלה</button>
                    <div class="logText" id="themeLog">-</div>
                </div>
            </div>

            <div class="row linebreak"></div>

        </div>

        <!-- chatbot -->

        <div class="content column manage page" id="chatbot">

            <p2>ניהול צ'אטבוט</p2>

            <div class="row linebreak"></div>

            <div class="row">
                <p>קבלת הגדרות0 לפה ועריכה של הנתונים</p>
            </div>

            <div class="row">
                <p>הוספת עובדות</p>
                <p>עריכת עובדות</p>
                <p>מחיקת עובדות</p>
            </div>

            <div class="row linebreak"></div>

        </div>

        </div>

        <button class="backToTopBtn" id="manageBackToTop" title="חזרה למעלה" aria-label="חזרה למעלה">↑</button>

        <%- include('./partials/footer'); %>

            <script src="js/script-manage.js"></script>

</body>

</html>