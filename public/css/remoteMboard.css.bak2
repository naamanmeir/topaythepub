:root {
    /* Modern Dark Theme Palette (Synced with style.css) */
    --bg01: #121212;
    --bg02: rgba(255, 255, 255, 0.1);
    --bg03: rgba(1, 30, 40, 0.2);

    --text01: #FFC107;
    --text02: #FFEB3B;
    --text03: #B0BEC5;
    --text04: #69F0AE;
    --textBlack: #212121;

    --border01: rgba(255, 193, 7, 0.3);
    --border02: #8D6E63;
    --border03: #4CAF50;

    --buttonYes: #4CAF50;
    --buttonNo: #FF5722;

    --buttonBgYes: #43A047;
    --buttonBgNo: #E64A19;

    --listItemOdd: #ECEFF1;
    --listItemEven: #CFD8DC;
    --listItemSelected: #90CAF9;

    --itemPrice: #2E7D32;
    --itemCount: #1B5E20;
    --itemName: #F57F17;
}

input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:blur,
input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px var(--bg01) inset !important;
    -webkit-text-fill-color: var(--text01) !important;
}

/* ------------------scrollbar--------------------- */
::-webkit-scrollbar {
    width: 6px;
}

::-webkit-scrollbar-corner,
::-webkit-scrollbar-track {
    background-color: var(--bg01);
}

::-webkit-scrollbar-thumb {
    background: var(--text01);
    border-radius: 10px;
}

/* ------------------scrollbar--------------------- */

@font-face {
    font-family: DanaYad;
    src: url('../fonts/danaYad/DanaYadAlefAlefAlef-Normal.eot');
    src: url('../fonts/danaYad/DanaYadAlefAlefAlef-Normal.eot') format('embedded-opentype'),
        url('../fonts/danaYad/DanaYadAlefAlefAlef-Normal.woff') format('woff'),
        url('../fonts/danaYad/DanaYadAlefAlefAlef-Normal.otf') format('truetype');
    font-display: swap;
}


html,
body {
    height: 100%;
    height: -webkit-fill-available;
    width: 100%;
    overscroll-behavior: contain;
    direction: rtl;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    -o-user-select: none;
    user-select: none;
    scroll-behavior: smooth;
    font-family: 'DanaYad', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 16px;
}

body {
    background-color: var(--bg01);
    color: var(--text01);
    margin: 0;
}

@media (max-width: 768px) {
    html {
        font-size: 14px;
    }
}

p {
    margin: 0px;
    padding: 0px;
}

/* ----------------------- HEADER MAIN HEADER --------------------------------------------- */

.header {
    z-index: 150;
    /* width: 100%; */
    height: fit-content;
    display: flex;
    text-align: center;
    right: 0px;
    margin: auto;
    margin-bottom: 0.2rem;
    margin-top: 0px;
    padding: 0px;
}

.shadow1 {
    text-shadow: 3px 1px 2px rgba(163, 130, 69, 0.616);
}

.header p {
    border-radius: 2rem;
    color: rgba(225, 170, 68, 0.896);
    font-size: 2.2rem;
    /* line-height: 0.4rem; */
    margin: 0px;
    /* margin-bottom: 0.2rem; */
    padding: 0px;
}

.animColor1 {
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0));
    background-color: transparent;
    background-size: 0px;
    animation: anim1Color1 64s ease infinite running;
}

@keyframes anim1Color1 {
    0% {
        filter: hue-rotate(0deg);
    }

    100% {
        filter: hue-rotate(360deg);
    }
}

.animColor2 {
    background-image: none;
    background-color: transparent;
    background-size: 0px;
    animation: anim1Color1 64s ease infinite running;
}

@keyframes anim2Color2 {
    0% {
        filter: hue-rotate(180deg);
    }

    100% {
        filter: hue-rotate(179deg);
    }
}

/* --------------------------MESSAGE BOARD------------------------------ */

.remoteMboardPage {
    /* height: 98vh; */
    /* width: 100vw; */
}

.messageBoardWindow {
    z-index: 80;
    position: relative;
    /* display: inline-block; */
    /* top: 10%; */
    /* left: 5%; */
    /* right: 5%; */
    width: 95vw;
    max-width: 650px;
    height: 88vh;
    margin: 0 auto 0 auto;
    background-color: var(--bg01);
    border: 1px solid var(--border02);
    /* padding: 1rem; */
    padding-top: 0.1rem;
    color: var(--text03);
}

.mBoardHeader {
    top: 0.05rem;
    margin-bottom: 0.5rem;
    color: var(--listItemSelected);
    display: flex;
    flex-direction: row;
    justify-content: center;
    font-size: 2.1rem;
    border: 1px groove rgb(3, 117, 143);
}

.postInputDiv {
    display: flex;
    flex-direction: row;
    margin: auto;
    margin-top: 0px;
    margin-bottom: 0px;
    margin-right: 5%;
    width: 95%;
    bottom: 0.2rem;
}

.postInputTypes {
    position: relative;
    display: flex;
    flex-direction: row;
    width: 80%;
    margin: auto;
    margin-top: 0px;
    margin-bottom: 1rem;
    bottom: 1vh;
    width: 80%;
}

.mboardButton {
    /* position: relative; */
    width: fit-content;
    height: fit-content;
    font-size: 1.5rem;
    color: black;
    left: 0px;
    margin: auto;
    margin-left: 0px;
    float: center;
    text-align: center;
    justify-content: center;
    background-color: var(--buttonYes);
    border: 1px outset grey;
}

.mboardButtonError {
    display: none;
    position: relative;
    width: fit-content;
    height: 2rem;
    font-size: 1.5rem;
    color: black;
    left: 0px;
    margin: auto;
    margin-left: 0px;
    float: center;
    text-align: center;
    justify-content: center;
    background-color: var(--buttonNo);
    border: 1px outset grey;
}

#imageAddButton {
    background-color: rgb(6, 101, 130);
    right: 0px;
    margin: auto;
    margin-right: 0px;
}

#imageRemoveButton {
    background-color: rgb(6, 101, 130);
    right: 0px;
    margin: auto;
    margin-right: 0px;
}

.mboardButton:active {
    border: 1px inset grey;
}

.postImgPreview {
    max-width: 5rem;
    max-height: 3rem;
}

.uploadImg {
    display: flex;
    height: fit-content;

}

.messageBoardBottom {
    position: absolute;
    display: none;
    margin: auto;
    text-align: center;
    bottom: 0.1rem;
    color: var(--itemPrice);
}

.postInput {
    resize: none;
    width: 90%;
    height: 3rem;
    box-sizing: border-box;
    border: 1px solid #ccc;
    border-radius: 3%;
    /* padding: 10px; */
    background-color: #1e44578c;
    font-size: 1.3rem;
    color: var(--itemPrice);
    overflow: hidden;
    user-select: auto;
    justify-content: center;
    align-items: center;

}

.posts {
    position: relative;
    height: 70vh;
    /* width: 97vw; */
    flex-wrap: nowrap;
    justify-content: center;
    margin: auto;
    margin-top: 0px;
    margin-bottom: 1%;
    right: 0px;
    transition: background-color 0.8s ease;
    overflow-y: auto;
    overflow-x: hidden;
    clear: both;
    word-wrap: break-word;
    /* scroll-behavior: smooth; */
}

.contextMenu {
    position: relative;
    padding: 0rem 1rem 0rem 1rem;
    margin: 0 auto 0 auto;
    display: flex;
    flex-direction: row;
    align-self: right;
    float: right;
    right: 0px;
}

.contextMenu img {
    padding: 0.4rem;
    margin: 0rem 1rem 0rem 1rem;
    filter: invert();
    background-color: #c2ccd6cc;
    width: 100%;
    height: 100%;
}

.cmenuItems {
    padding: 0.5rem;
    margin: 0rem 1rem 0rem 1rem;
    filter: invert();
    background-color: #c2ccd6cc;
    width: 1.5rem;
    height: 1.5rem;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

#anchor {
    overflow-anchor: auto;
    height: 1px;
}

.postDisplay {
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    border: 1px dotted rgb(6, 143, 129);
    border-radius: 2%;
    display: flex;
    margin-bottom: 0.5rem;
    padding-left: 1rem;
    padding-bottom: 0.2rem;
    width: fit-content;
    max-width: 95%;
    padding-right: 2%;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
    white-space: pre-line;
    pointer-events: auto;
}

.postDisplay #contextMenu {
    z-index: 150;
    width: fit-content;
    height: fit-content;
    position: absolute;
    padding: 0.5rem;
    margin: auto;
    color: white;
    background-color: rgba(23, 107, 140, 0.526);
}

.postDisplayImg {
    max-width: 80%;
    max-height: 90%;
    margin-bottom: 0px;
    padding: 1.2rem;
    padding-bottom: 0px;
    user-zoom: auto;
}

.postDisplayImg img {
    user-zoom: auto;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    pointer-events: none;
}

.postDisplay p {
    font-size: 1rem;
    width: 100%;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
    user-select: text;
}

.oddPost {
    background-color: #122c34b3;
}

.evenPost {
    background-color: #103b4fc1;
}

.postPind {
    background-color: rgba(167, 255, 4, 0.39);
}

.chatbotPost {
    font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
    color: #8ace88;
    border: 1px dotted rgb(6, 143, 129);
    border-radius: 2%;
    left: 0px;
    margin-right: 2rem;
    background-color: #051930c1;
    user-select: text;
}

.systemPost {
    background-color: rgba(255, 175, 0, 0.11);
    margin: auto;
    align-self: center;
    align-items: center;
    color: rgb(253, 153, 117);
    width: fit-content;
}

.progressBarDiv {
    width: 80%;
    margin: auto;
    margin-top: 4px;
    margin-bottom: 4px;
    height: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    /* position: absolute; */
}

.progressBar {
    background-color: green;
    height: 10px;
    width: 0px;
}

@media screen and (max-height: 700px),
(max-width: 500px) {
    .messageBoardWindow {
        /* height: 80vh; */
        /* top: 7%; */
    }

    .postInput {
        height: 2rem;
        /* font-size: 1rem; */
    }

    .mboardButton {
        /* position: absolute; */
        /* bottom: 1rem; */
        font-size: 1.2rem;
    }


}

@media screen and (max-height: 525px) {
    .messageBoardWindow {
        /* height: 78vh; */
    }

    .postInput {
        /* height: 1.7rem; */
        /* font-size: 1rem; */
    }

}

@media screen and (max-height: 425px) {
    .messageBoardWindow {
        height: 58vh;
    }

    .postInput {
        /* height: 1.5rem; */
        /* font-size: 1rem; */
    }

    .mboardButton {
        font-size: 1rem;
    }
}